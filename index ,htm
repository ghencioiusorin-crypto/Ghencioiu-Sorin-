HTML

<!DOCTYPE html>
<html lang="ro">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sorin Studio</title>
<style>
body{font-family:Arial;background:#101827;color:white;text-align:center;padding:20px}
h1{color:#f5bd45}
textarea{width:95%;height:130px;padding:10px;border-radius:10px}
button{padding:14px;margin:10px;background:#f5bd45;border:0;border-radius:10px;font-weight:bold}
</style>
</head>
<body>
<h1>🎬 Sorin Studio</h1>
<h2>Filme și Povești</h2>
<p>Bine ai venit în aplicația mea!</p>
<textarea id="idee" placeholder="Scrie aici ideea poveștii tale..."></textarea>
<br>
<button onclick="creeaza()">Creează poveste</button>
<p id="rezultat"></p>
<script>
function creeaza(){
let idee=document.getElementById("idee").value;
document.getElementById("rezultat").innerText=
idee ? "Ideea ta pentru poveste: "+idee : "Scrie mai întâi o idee!";
}
</script>
</body>
</html>
